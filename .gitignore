# Lokalno okolje Python in predpomnilniki
/.python-deps/
/.venv/
/venv/
/env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/.tmp/

# Lokalne odvisnosti gradnje (Playwright, BeautifulSoup, PyMuPDF …, ~200 MB).
# Namestitev: python -m pip install --target tmp/okolje-runtime -r requirements.txt
/tmp/

# Lokalne skrivnosti (vzorci nastavitev ostanejo vključeni)
.env
.env.*
!.env.example
!.env.sample

# Lokalne nastavitve urejevalnikov in orodij
.vscode/
.idea/
.claude/settings.local.json

# Začasne datoteke operacijskega sistema, urejevalnikov in pisarniških programov
.DS_Store
Thumbs.db
desktop.ini
~$*
*.swp
*.swo
*.tmp
*.log

# Viri, podatki, wiki, arhiv, preverjanje in zgrajena poročila
# namenoma ostanejo vključeni zaradi sledljivosti in rabe brez omrežja.
